# Optional: when empty, the catalog uses local example products.
WP_GRAPHQL_URL=http://wordpress.local/graphql

# WordPress/WooCommerce base URLs.
NEXT_PUBLIC_WP_URL=http://wordpress.local
WOO_BASE_URL=http://wordpress.local

# When set, Next proxies Woo transactional routes under the storefront domain.
WOO_PROXY_TARGET=http://wordpress.local
