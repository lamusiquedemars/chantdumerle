.quantity {
  max-width: 96px;
  padding: 10px 12px;
  border: 1px solid #d8cbbb;
  border-radius: 10px;
  font: inherit;
}

.cartButton {
  width: 100%;
  margin-top: 1rem;
  padding: 0.85rem 1rem;
  border: none;
  border-radius: 999px;
  background: #22160f;
  color: #fffaf4;
  font-weight: 600;
  cursor: pointer;
}

.cartButton:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.notice {
  margin: 0.85rem 0 0;
  padding: 0.75rem 0.85rem;
  color: #2f6f45;
  background: rgba(47, 111, 69, 0.1);
  border: 1px solid rgba(47, 111, 69, 0.22);
  border-radius: 10px;
  font-size: 0.9rem;
  font-weight: 700;
}

.noticeError {
  margin: 0;
  color: #8c2f1c;
  font-size: 0.9rem;
  font-weight: 600;
}

.noticeError p {
  margin: 0;
}

.fallbackLink {
  display: inline-block;
  margin-top: 0.5rem;
  text-decoration: underline;
  text-underline-offset: 0.18em;
}
